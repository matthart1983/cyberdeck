#!/usr/bin/env bash
# Cyberpunk HUD — a four-pane tmux grid of the *Watch tools.
#   hud          attach (creating the session if needed)
#   hud -r       tear down and rebuild
set -euo pipefail

# The panes are cargo installs and this script is spawned by the compositor as
# often as by a shell — a bar click, a keybind, a dock icon — so the PATH it
# hands tmux has to be the rice's, not /usr/local/bin:/usr/bin. Without this
# every pane dies on "command not found" the moment the HUD is opened from
# anywhere but a terminal.
# shellcheck source=common/lib-path.sh
. "$HOME/.dotfiles/common/lib-path.sh"

SESSION="hud"

if [[ ${1:-} == "-r" ]]; then
  tmux kill-session -t "$SESSION" 2>/dev/null || true
fi

if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  # Named pane targets ({left}, {top-right}) rather than numeric ones —
  # this config sets pane-base-index 1, so ".0" does not exist.
  #
  # soundwatch is macOS-only: it binds a CoreAudio tap and there is no Linux
  # build. Rather than open a pane that dies immediately, drop to a three-pane
  # grid where it is absent — the same degradation the README promises for any
  # missing tool.
  if command -v soundwatch >/dev/null; then
    tmux new-session -d -s "$SESSION" -n grid "soundwatch --theme btop"
    tmux split-window -h -t "$SESSION:grid"              "netwatch --lite"
    tmux split-window -v -t "$SESSION:grid.{left}"       "syswatch --lite"
    tmux split-window -v -t "$SESSION:grid.{top-right}"  "diskwatch --lite"
  else
    tmux new-session -d -s "$SESSION" -n grid "netwatch --lite"
    tmux split-window -h -t "$SESSION:grid"              "syswatch --lite"
    tmux split-window -v -t "$SESSION:grid.{right}"      "diskwatch --lite"
  fi
  tmux select-layout -t "$SESSION:grid" tiled
  tmux select-pane   -t "$SESSION:grid.{top-left}"
fi

if [[ ! -t 1 ]]; then
  # No terminal to attach to (scripted use) — build it and report.
  tmux list-panes -t "$SESSION" -F "pane #{pane_index}: #{pane_current_command} dead=#{pane_dead}"
  exit 0
fi

if [[ -n ${TMUX:-} ]]; then
  tmux switch-client -t "$SESSION"
else
  tmux attach -t "$SESSION"
fi
