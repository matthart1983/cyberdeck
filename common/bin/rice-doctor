#!/usr/bin/env bash
# Health check for every moving part of the rice.
# The layers differ completely between platforms — aerospace/sketchybar/launchd
# on one side, niri/waybar/systemd on the other — so there is no shared body
# worth factoring out. This just picks the right one.
set -euo pipefail
D="${D:-$HOME/.dotfiles}"

# The HUD's panes are cargo installs, and cargo's bin dir is on PATH only for
# shells that have sourced a profile. rice-doctor gets run from bars, keybinds
# and scripts that have not, so put it there before checking anything —
# otherwise the tools read as missing when they are sitting right there.
for d in "$HOME/.cargo/bin" "$HOME/.local/bin" "$D/common/bin"; do
  [ -d "$d" ] && case ":$PATH:" in *":$d:"*) ;; *) PATH="$d:$PATH" ;; esac
done
export PATH

case "$(uname -s)" in
  Darwin) exec bash "$D/macos/bin/rice-doctor" "$@" ;;
  Linux)  exec bash "$D/linux/bin/rice-doctor" "$@" ;;
  *)      echo "rice-doctor: unsupported platform $(uname -s)" >&2; exit 1 ;;
esac
