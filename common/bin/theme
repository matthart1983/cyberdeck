#!/usr/bin/env bash
# Switch the rice's palette, everywhere, in one command.
#
#   theme                 what's active, and what else there is
#   theme blade           switch: render all 13 surfaces, re-link, reload what
#                         is running, and name what you still have to restart
#   theme blade --render-only   rewrite the files and stop
#   theme --render        re-render the active theme (install.sh calls this)
#   theme --check         render to a temp tree and report drift, writing nothing
#
# Thirteen surfaces mirror the palette, in nine different colour notations.
# They were mirrored by hand until now, which meant eight themes would have
# been 104 files that could drift with nothing to catch it. Each one is a
# .tmpl beside its output; this renders them.
#
# Which theme you run is a property of your machine, so themes/active.sh is a
# symlink and is not tracked. The rendered surfaces ARE tracked, on purpose:
# `theme blade && git diff` shows you every surface that moved, and the repo
# stays something you can read and steal one file out of.
set -euo pipefail
D="${D:-$HOME/.dotfiles}"
# shellcheck source=common/lib.sh
source "$D/common/lib.sh"

RENDER="$D/common/bin/theme-render"

die() { printf '  %s✘%s %s\n' "$_c_warn" "$_c_off" "$*" >&2; exit 1; }

# template (relative to $D)                     output (relative to $D)
SURFACES=(
  "common/ghostty/config.tmpl                   common/ghostty/config"
  "common/ghostty/themes/theme.tmpl             common/ghostty/themes/cyberdeck"
  "common/tmux/tmux.conf.tmpl                   common/tmux/tmux.conf"
  "common/bat/themes/theme.tmTheme.tmpl         common/bat/themes/cyberdeck.tmTheme"
  "common/btop/themes/theme.theme.tmpl          common/btop/themes/cyberdeck.theme"
  "common/zed/themes/theme.json.tmpl            common/zed/themes/cyberdeck.json"
  "common/atuin/themes/theme.toml.tmpl          common/atuin/themes/cyberdeck.toml"
  "common/zsh/cyberpunk.zsh.tmpl                common/zsh/cyberpunk.zsh"
  "linux/waybar/style.css.tmpl                  linux/waybar/style.css"
  "linux/niri/config.kdl.tmpl                   linux/niri/config.kdl"
  "macos/sketchybar/colors.sh.tmpl              macos/sketchybar/colors.sh"
  "macos/bin/borders.sh.tmpl                    macos/bin/borders.sh"
  "capture/theme.tape.tmpl                      capture/theme.tape"
)

active_slug() {
  local a="$D/themes/active.sh"
  [ -e "$a" ] || { echo "cyberpunk-neon"; return; }
  sed -n 's/^CP_THEME_SLUG="\(.*\)"$/\1/p' "$a" | head -1
}

palette_for() { printf '%s/themes/%s.sh' "$D" "$1"; }

list() {
  local cur; cur="$(active_slug)"
  printf '\n  %sactive%s  %s\n\n' "$_c_chg" "$_c_off" "$cur"
  local f slug name
  for f in "$D"/themes/*.sh; do
    slug="$(basename "$f" .sh)"
    [ "$slug" = active ] && continue
    name="$(sed -n 's/^CP_THEME_NAME="\(.*\)"$/\1/p' "$f" | head -1)"
    if [ "$slug" = "$cur" ]; then
      printf '    %s●%s %-16s %s\n' "$_c_chg" "$_c_off" "$slug" "$name"
    else
      printf '      %-16s %s\n' "$slug" "$name"
    fi
  done
  printf '\n  theme <slug> to switch\n\n'
}

# render_all PALETTE DESTROOT — DESTROOT empty means "in place, over the repo".
# Only writes on difference, so a re-render of an unchanged theme leaves the
# working tree clean and install.sh reports nothing.
render_all() {
  local palette="$1" destroot="${2:-}" row tpl out dest tmp
  for row in "${SURFACES[@]}"; do
    read -r tpl out <<<"$row"
    [ -f "$D/$tpl" ] || { warn "missing template: $tpl"; continue; }
    if [ -n "$destroot" ]; then dest="$destroot/$out"; else dest="$D/$out"; fi
    mkdir -p "$(dirname "$dest")"
    tmp="$(mktemp)"
    "$RENDER" "$palette" "$D/$tpl" "$tmp"
    if [ -f "$dest" ] && cmp -s "$tmp" "$dest"; then
      rm -f "$tmp"; same "$out"
    else
      mv "$tmp" "$dest"
      # mktemp is 600 and two of the outputs are run, not read. chmod --reference
      # would be tidier and is GNU-only; this repo also has to work on macOS.
      case "$out" in
        *.sh) chmod 755 "$dest" ;;
        *)    chmod 644 "$dest" ;;
      esac
      chg "$out"
    fi
  done
}

case "${1:-}" in
  ""|-l|--list)
    list
    ;;

  --check)
    # What test/theme.sh runs: prove the tracked surfaces are exactly what the
    # templates produce, without touching them.
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
    slug="$(active_slug)"
    render_all "$(palette_for "$slug")" "$tmp" >/dev/null
    drift=0
    for row in "${SURFACES[@]}"; do
      read -r tpl out <<<"$row"
      if ! cmp -s "$tmp/$out" "$D/$out"; then
        warn "drifted: $out"; drift=1
      fi
    done
    if [ "$drift" -eq 0 ]; then
      printf '  %s=%s 13 surfaces match themes/%s.sh\n' "$_c_ok" "$_c_off" "$slug"
    fi
    exit "$drift"
    ;;

  --render)
    echo "==> theme"
    render_all "$(palette_for "$(active_slug)")"
    summary "theme"
    ;;

  -h|--help)
    sed -n '2,12p' "$0" | sed 's/^# \?//'
    ;;

  -*)
    echo "theme: unknown option $1" >&2; exit 2
    ;;

  *)
    slug="$1"
    palette="$(palette_for "$slug")"
    if [ ! -f "$palette" ]; then
      echo "theme: no such theme '$slug'" >&2
      echo "       have: $(cd "$D/themes" && ls *.sh | sed 's/\.sh$//' | grep -v '^active$' | tr '\n' ' ')" >&2
      exit 1
    fi

    # --render-only exists for test/theme.sh, which switches through all eight
    # themes in a throwaway copy of the repo and must not touch a real ~/.config.
    if [ "${2:-}" = --render-only ]; then
      echo "==> $slug (render only)"
      render_all "$palette"
      ln -sfn "$slug.sh" "$D/themes/active.sh"
      summary "theme"
      exit 0
    fi

    CP_THEME_NAME_NEW="$(sed -n 's/^CP_THEME_NAME="\(.*\)"$/\1/p' "$palette" | head -1)"
    ln -sfn "$slug.sh" "$D/themes/active.sh"

    # install.sh renders (via --render) and re-links, and reloads the bar if it
    # wrote anything. Going through it rather than repeating it here means there
    # is one path onto the machine, not two that can disagree.
    #
    # Its full output is forty lines of "= already correct", which is the right
    # thing for install.sh to print and the wrong thing for this. Keep the
    # writes and the warnings, drop the rest — and dump everything if it fails,
    # because then the forty lines are exactly what you want.
    echo "==> $slug"
    if ! install_out="$(CYBERDECK_PLAIN=1 bash "$D/install.sh" 2>&1)"; then
      printf '%s\n' "$install_out"
      die "install.sh failed — the palette is switched but the links are not"
    fi
    printf '%s\n' "$install_out" | grep -E '^  [+!]' || true

    # tmux holds its colours in a running server, so it needs telling. niri
    # watches its own config file and Zed watches its themes directory; both
    # have already picked this up by now.
    echo "==> live surfaces"
    if tmux list-sessions >/dev/null 2>&1; then
      tmux source-file "$HOME/.config/tmux/tmux.conf" >/dev/null 2>&1 \
        && chg "tmux reloaded" || warn "tmux is running but would not reload"
    else
      same "tmux (not running)"
    fi

    # What is left is what genuinely cannot be reloaded from outside: Ghostty
    # has no reload-from-CLI, and a shell's exported colours are fixed at start.
    printf '\n  %snow on %s%s\n' "$_c_chg" "$CP_THEME_NAME_NEW" "$_c_off"
    left=""
    pgrep -x ghostty >/dev/null 2>&1 && left="$left
    ghostty   ctrl+shift+, to reload — colours apply to new windows"
    [ -n "${TMUX:-}${ZSH_VERSION:-}" ] && left="$left
    zsh       exec zsh (this shell's exported colours are fixed at start)"
    pgrep -x btop >/dev/null 2>&1 && left="$left
    btop      restart it"
    if [ -n "$left" ]; then
      printf '  still to do:%s\n\n' "$left"
    else
      printf '  nothing left to restart.\n\n'
    fi
    ;;
esac
