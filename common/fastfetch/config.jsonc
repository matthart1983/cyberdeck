// Cyberdeck — fastfetch. Rendered from themes/<active>.sh by `theme`;
// edit config.jsonc.tmpl, never this file.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.dotfiles/common/fastfetch/logo.txt",
    "color": {
      "1": "38;2;94;200;255",
      "2": "38;2;201;220;234",
      "3": "38;2;74;111;165"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " \u001b[38;2;74;111;165m▸\u001b[0m ",
    "color": {
      "keys": "38;2;94;200;255",
      "title": "38;2;201;220;234"
    },
    "constants": [
      "\u001b[38;2;74;111;165m"
    ]
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "38;2;94;200;255",
        "at": "38;2;74;111;165",
        "host": "38;2;201;220;234"
      }
    },
    {
      "type": "custom",
      "format": "{$1}╭──────────────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "  os     "
    },
    {
      "type": "kernel",
      "key": "  kernel "
    },
    {
      "type": "host",
      "key": "  host   "
    },
    {
      "type": "uptime",
      "key": "  uptime "
    },
    {
      "type": "packages",
      "key": "  pkgs   "
    },
    {
      "type": "shell",
      "key": "  shell  "
    },
    {
      "type": "terminal",
      "key": "  term   "
    },
    {
      "type": "custom",
      "format": "{$1}├──────────────────────────────────────────────┤"
    },
    {
      "type": "cpu",
      "key": "  cpu    "
    },
    {
      "type": "gpu",
      "key": "  gpu    "
    },
    {
      "type": "memory",
      "key": "  memory "
    },
    {
      "type": "disk",
      "key": "  disk   ",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "  power  "
    },
    {
      "type": "display",
      "key": "  screen "
    },
    {
      "type": "localip",
      "key": "  lan    "
    },
    {
      "type": "custom",
      "format": "{$1}╰──────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    },
    "break"
  ]
}
