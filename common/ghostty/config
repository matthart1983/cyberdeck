# Cyberpunk rice — Ghostty
# Managed in ~/.dotfiles/common/ghostty/config, symlinked to ~/.config/ghostty/config
# Rendered from themes/ice.sh by `theme` — edit the .tmpl, not this.

theme = cyberdeck

# --- Type ------------------------------------------------------------------
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
font-thicken = true
adjust-cell-height = 12%

# --- Translucency: most of the cyberpunk read comes from this --------------
background-opacity = 0.88
background-blur = 26

# --- Chrome ----------------------------------------------------------------
window-padding-x = 16
window-padding-y = 14
window-padding-balance = true
window-decoration = true
window-width = 200
window-height = 52

# The window's own close button lives in the titlebar, which is the one place
# a control is always where the window is rather than up on the bar. `ghostty`
# is what makes that chrome take the palette instead of the system's grey. The
# two colour keys below are GTK-only and inert on macOS, but the palette owns
# them either way — BG_ALT is the bar's fill, so bar and titlebar read as the
# same surface.
window-theme = ghostty
window-titlebar-background = #0e141d
window-titlebar-foreground = #c9dcea

# --- Cursor ----------------------------------------------------------------
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

# --- Splits: dim what isn't focused ---------------------------------------
unfocused-split-opacity = 0.72
unfocused-split-fill = #05080d

# --- Behaviour -------------------------------------------------------------
shell-integration = zsh
shell-integration-features = cursor,sudo,title
copy-on-select = clipboard
confirm-close-surface = false
window-save-state = always
scrollback-limit = 100000

# --- Platform half ---------------------------------------------------------
# Everything above is identical on macOS and Linux. The chrome keys and the
# whole keybind block are not: cmd does not exist on Linux, and the GTK build
# has no macos-* settings. install.sh links the right one of
# ghostty/platform-{macos,linux}.conf here.
config-file = ~/.config/ghostty/platform.conf
