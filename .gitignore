# Never commit secrets — the real file lives at ~/.config/secrets.zsh (chmod 600)
secrets.zsh
*.secret
.DS_Store

# Generated wallpapers are large binaries; the generator is committed instead.
wallpaper/*.png

# Pre-rice backups of the user's own files
attic/

# Rendered demo GIFs — the three in the README are committed; anything else
# you render locally is not.
capture/out/*.gif
!capture/out/fetch.gif
!capture/out/shell.gif
!capture/out/hud.gif
!capture/out/tour.gif

# Machine-specific snapshot of YOUR pre-rice defaults. Generated by
# macos/snapshot.sh; shipping mine would restore my settings onto your Mac.
macos/before.txt
__pycache__/
