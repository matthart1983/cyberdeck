# Shared look for every rice capture. Sourced by the other tapes.
# Rendered from themes/deep-sea.sh by `theme` — edit the .tmpl, not this.
Set Shell "zsh"
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 18
Set Padding 24
Set TypingSpeed 55ms
Set Theme { "name": "Deep Sea", "background": "#060b16", "foreground": "#7fd1d6", "cursor": "#5d86ff", "selection": "#1e3a5f", "black": "#030710", "red": "#e05a6b", "green": "#4fc9a0", "yellow": "#d9c46a", "blue": "#1e3a5f", "magenta": "#5d86ff", "cyan": "#7fd1d6", "white": "#e6f2f5", "brightBlack": "#1e333c", "brightRed": "#eb919d", "brightGreen": "#8adcc1", "brightYellow": "#e7d99c", "brightBlue": "#4f95d4", "brightMagenta": "#94afff", "brightCyan": "#aae1e5", "brightWhite": "#ffffff" }
