# Shared look for every rice capture. Sourced by the other tapes.
# Rendered from themes/ice.sh by `theme` — edit the .tmpl, not this.
Set Shell "zsh"
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 18
Set Padding 24
Set TypingSpeed 55ms
Set Theme { "name": "Ice", "background": "#05080d", "foreground": "#c9dcea", "cursor": "#5ec8ff", "selection": "#1f3a55", "black": "#020406", "red": "#ff5c72", "green": "#7fd6b5", "yellow": "#e0d48a", "blue": "#1f3a55", "magenta": "#5ec8ff", "cyan": "#c9dcea", "white": "#f2f7fb", "brightBlack": "#2c3239", "brightRed": "#ff93a2", "brightGreen": "#aae5ce", "brightYellow": "#ebe3b1", "brightBlue": "#5f95cc", "brightMagenta": "#95dbff", "brightCyan": "#dbe8f1", "brightWhite": "#ffffff" }
