/* ---------------------------------------------------------------------------
   Cyberpunk rice — Waybar stylesheet
   ~/.dotfiles/linux/waybar/style.css  ->  ~/.config/waybar/style.css

   Mirrors sketchybar/colors.sh by hand. GTK CSS has @define-color, so unlike
   the macOS bar this one at least gets named colours instead of raw 0xAARRGGBB
   literals everywhere.
   --------------------------------------------------------------------------- */

@define-color bg        __CP_BG__;
@define-color bg_alt    __CP_BG_ALT__;
@define-color border    __CP_BG_HI__;
@define-color fg        __CP_FG__;
@define-color fg_dim    __CP_FG_DIM__;
@define-color white     __CP_FG_STRONG__;
@define-color magenta   __CP_MAGENTA__;
@define-color purple    __CP_PURPLE__;
@define-color blue      __CP_BLUE__;
@define-color orange    __CP_ORANGE__;
@define-color red       __CP_RED__;
@define-color yellow    __CP_YELLOW__;
@define-color green     __CP_GREEN__;

* {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 13px;
  font-weight: 500;
  border: none;
  border-radius: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
}

window#waybar {
  /* ~90% opaque, matching BAR_BG=0xe6__CP_BG_RAW__ */
  background: alpha(@bg, 0.9);
  border: 1px solid @border;
  border-radius: 8px;
  color: @white;
}

window#waybar.hidden { opacity: 0.2; }

/* --- Left ---------------------------------------------------------------- */
#workspaces { padding: 0 4px; }

#workspaces button {
  color: @fg_dim;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 0 9px;
  margin: 3px 1px;
  font-weight: bold;
  transition: color 120ms ease, background 120ms ease;
}

#workspaces button:hover {
  color: @fg;
  background: alpha(@blue, 0.2);
  box-shadow: none;
}

#workspaces button.active {
  color: @bg;
  background: @magenta;
  border-color: @magenta;
}

#workspaces button.urgent {
  color: @bg;
  background: @red;
}

#custom-sep {
  color: @purple;
  padding: 0 6px;
}

#window {
  color: @fg;
  font-weight: bold;
  padding: 0 6px;
}

window#waybar.empty #window { background: transparent; }

/* --- Right --------------------------------------------------------------- */
#custom-link,
#custom-net,
#cpu,
#memory,
#disk,
#battery,
#clock {
  padding: 0 8px;
  margin: 3px 1px;
  border-radius: 6px;
  color: @white;
}

/* Each item keeps the icon colour its macOS counterpart had. Waybar can't
   colour the icon separately from the label inside one module, so the accent
   moves to the whole item and the neutral ones stay white. */
#custom-link { color: @green; }
#custom-net  { color: @fg; font-size: 12px; }
#cpu         { color: @white; }
#memory      { color: @white; }
#disk        { color: @white; }
#clock       { color: @magenta; font-weight: bold; }

/* State colours — Waybar sets these classes from the "states" map. */
#cpu.warning,
#memory.warning,
#disk.warning,
#battery.warning { color: @orange; }

#cpu.critical,
#memory.critical,
#disk.critical   { color: @red; }

#battery.critical:not(.charging) {
  color: @bg;
  background: @red;
  animation: blink 1.2s steps(2) infinite;
}
#battery.good     { color: @green; }
#battery.charging { color: @green; }

/* The link item recolours itself from the script's "class" field: it goes
   yellow, orange, then red on the worst of gateway RTT / DNS RTT / loss. */
#custom-link.ok    { color: @green; }
#custom-link.warn  { color: @yellow; }
#custom-link.bad   { color: @orange; }
#custom-link.loss  { color: @red; }
#custom-link.down  { color: @fg_dim; }
#custom-net.down   { color: @fg_dim; }

@keyframes blink {
  to { color: @red; background: @bg_alt; }
}

tooltip {
  background: @bg_alt;
  border: 1px solid @purple;
  border-radius: 6px;
}
tooltip label { color: @fg; padding: 4px; }
