// ---------------------------------------------------------------------------
// Cyberpunk rice — Waybar
// ~/.dotfiles/linux/waybar/config.jsonc  ->  ~/.config/waybar/config.jsonc
//
// Two bars out of one process: the status bar along the top, and the
// application dock along the bottom. Waybar takes an ARRAY here and gives each
// object its own surface, which is why this is not two configs and two
// daemons — one reload (SIGUSR2) moves both, and one stylesheet paints both,
// with "name" as the class that tells them apart.
//
// The Linux stand-in for sketchybar/sketchybarrc. Read the right side
// right-to-left: clock, battery, disk, mem, cpu, net, link — the same order
// as the macOS bar.
//
// One structural difference worth knowing: on macOS, cpu/mem/disk/battery each
// needed a shell plugin, because `top`, `memory_pressure` and `pmset` have to
// be parsed. Waybar reads all four from /proc and /sys itself, so those four
// plugins simply don't exist here. The two that DO still need scripts are the
// netwatch-fed ones — link and net — because that data comes from netwatch's
// Prometheus endpoint, not from the kernel. That was always the point.
// ---------------------------------------------------------------------------
[
  {
    "name": "top",
    // SIGUSR1 is the dock's, not this bar's. Both bars come out of one waybar,
    // so the signal reaches both — and on-sigusr1 is a PER-BAR parameter,
    // which is what lets `pkill -USR1 waybar` mean "hide the dock" and leave
    // the status bar alone. That is the whole reason the dock did not need to
    // become a second process.
    "on-sigusr1": "noop",
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 2,

    "modules-left":   ["custom/launcher", "custom/run", "niri/workspaces", "custom/sep", "niri/window"],
    "modules-center": [],
    "modules-right":  ["custom/link", "custom/net", "cpu", "memory", "disk", "pulseaudio/slider", "wireplumber", "custom/display", "custom/power-profile", "battery", "clock", "custom/power"],

    // --- Left: the launcher button ------------------------------------------
    // Opens nwg-drawer, not fuzzel: a button is for the times you are looking
    // rather than typing, and the drawer is the one that answers that. It drops
    // down from here as a panel, so the button and its menu read as one thing.
    // linux/bin/drawer is what sizes that panel to the current output and
    // toggles the resident copy. Typing has its own button beside this one —
    // it used to be this button's right-click, which is no more findable than
    // the keybind it was standing in for.
    "custom/launcher": {
      "format": "󰀻",
      "tooltip": true,
      "tooltip-format": "Browse applications  (Mod+A)",
      "on-click": "~/.dotfiles/linux/bin/drawer"
    },

    // --- Left: the run button ------------------------------------------------
    // The other half of the pair: fuzzel, for when you can name the thing.
    // Toggles, so a second click dismisses a prompt that is already up rather
    // than failing silently — fuzzel refuses to run twice.
    "custom/run": {
      "format": "󰍉",
      "tooltip": true,
      "tooltip-format": "Run a program  (Mod+Space)",
      "on-click": "pkill fuzzel || fuzzel"
    },

    // --- Left: niri workspaces, named exactly as the compositor names them ---
    "niri/workspaces": {
      "format": "{icon}",
      // Material Design glyphs, the same set the right-hand items use. The
      // labels were "1".."6", which the six pinned workspaces would have got
      // from {index} anyway — the map only earns its place saying something
      // the index cannot.
      "format-icons": {
        "term":  "󰆍",
        "code":  "󰅩",
        "web":   "󰖟",
        "chat":  "󰭹",
        "notes": "󰎚",
        "infra": "󰒋"
      },
      "on-click": "activate"
    },

    "custom/sep": {
      "format": "│",
      "tooltip": false
    },

    "niri/window": {
      "format": "  {}",
      "max-length": 48,
      "separate-outputs": true
    },

    // --- The two netwatch-fed items -----------------------------------------
    // --font-size, for the same reason the HUD carries one. netwatch's dense
    // view wants 130x44 and does not say so when it cannot have it — below 44
    // rows it quietly draws two of its four boxes, which reads as a broken
    // render rather than a refusal. A maximised ghostty on this display at the
    // configured 14 is 168x38: wide enough and six rows short, so `V` could
    // never reach dense however far you zoomed. At 11 it is 211x48.
    //
    // --class is the other half, and without it the font size alone bought
    // nothing. "Maximised" was doing unexamined work in that paragraph: a
    // ghostty opened from here is not maximised, it is one column at niri's
    // default preset width, which is half the screen. So the window that
    // actually appeared was 100x49 — the rows the font size was chosen for,
    // and 30 columns short of dense, which draws two boxes for being narrow
    // exactly as it does for being short. The rule that maximises these is
    // in config.kdl and matches on app-id prefix; the dock's terminal tools
    // get it because linux/bin/dock spells the class out, and this did not.
    // Full width at 11 is 206x49, which clears dense on both axes.
    //
    // Its own suffix rather than the dock's `-net`: that slot is termshark,
    // and sharing the class would make `dock open net` focus this window
    // instead of launching it.
    "custom/link": {
      "exec": "~/.config/waybar/scripts/link.sh",
      "return-type": "json",
      "interval": 5,
      "on-click": "ghostty --class=com.mitchellh.ghostty-netwatch --font-size=11 -e netwatch"
    },

    "custom/net": {
      "exec": "~/.config/waybar/scripts/net.sh",
      "return-type": "json",
      "interval": 2,
      "on-click": "ghostty --class=com.mitchellh.ghostty-netwatch --font-size=11 -e netwatch"
    },

    // --- Kernel-fed items ----------------------------------------------------
    "cpu": {
      "format": "󰻠 {usage}%",
      "interval": 3,
      "states": { "warning": 70, "critical": 90 },
      "on-click": "ghostty -e btop"
    },

    "memory": {
      "format": "󰍛 {percentage}%",
      "interval": 5,
      "states": { "warning": 80, "critical": 92 },
      "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
      "on-click": "ghostty -e btop"
    },

    "disk": {
      // On Linux `/` is the real root — no sealed-snapshot workaround needed.
      "path": "/",
      "format": "󰋊 {percentage_used}% · {free} free",
      "interval": 300,
      "states": { "warning": 85, "critical": 93 }
    },

    // --- Right: volume, as a thing you can actually drag ---------------------
    // Scrolling a bar item is a mouse-wheel gesture. This is a laptop, and on
    // this machine the module never received a scroll event at all — so the
    // volume was readable and mutable from the bar, and not settable, which is
    // the one thing a volume control is for.
    //
    // So the control is a slider: click anywhere on it to jump there, or drag
    // it. Both are gestures a trackpad is good at. The readout beside it keeps
    // the number and the mute state, and the scroll handlers stay configured
    // because they cost nothing and a mouse may yet get plugged in.
    "pulseaudio/slider": {
      "min": 0,
      "max": 100,
      "orientation": "horizontal"
    },

    // --- Right: volume ------------------------------------------------------
    // The wireplumber module, not pulseaudio: waybar links both, and this rice
    // runs PipeWire with wireplumber as its session manager — the same daemon
    // the Framework's hardware keys already drive through wpctl.
    //
    // Scroll sets it, click mutes, right-click opens soundwatch — the same
    // idiom as cpu and memory opening btop, and the two netwatch items opening
    // netwatch. Muting is what a volume item is mostly for, so it keeps the
    // left button and the tool gets the right.
    //
    // The scroll handlers are spelled out rather than left to the module's
    // built-in one, and the reason is the ceiling. waybar's own handler steps
    // by `scroll-step` up to `max-volume`; config.kdl's XF86Audio binds step by
    // 5% up to `--limit 1.0`. Two implementations of the same rule is one more
    // than is needed, and they drift the first time either number is edited.
    // The man page is explicit that on-scroll-up/down REPLACE the default, so
    // this is one rule: the bar runs the identical wpctl the keyboard runs.
    "wireplumber": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟 muted",
      "format-icons": ["󰕿", "󰖀", "󰕾"],
      "tooltip-format": "{node_name}  ·  {volume}%\ndrag the slider to set · click to mute · right-click for soundwatch",
      // Kept for a mouse, and a threshold so that if one ever is plugged in it
      // steps once per notch. Not the control this item relies on: see the
      // slider above for why.
      "smooth-scrolling-threshold": 1,
      "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.0",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "on-click-right": "ghostty -e soundwatch"
    },

    // --- Right: the display --------------------------------------------------
    // Sits beside volume because it is the same kind of thing: a hardware knob
    // you reach for a few times a week and never want to go hunting for.
    //
    // Click opens the picker — scales first, then every mode the focused output
    // actually reports. Right-click puts back what config.kdl asks for, which
    // matters more here than elsewhere: `niri msg output` is explicitly
    // temporary, so the bar can only ever hand you a setting for the afternoon.
    // linux/bin/display is where the whole of that is written down.
    //
    // Polled rather than pushed, at an interval slow enough not to matter: the
    // thing it is watching is a monitor being plugged in, and niri's event
    // stream is a socket this item would have to hold open all session to learn
    // that five seconds sooner. The signal is for the other case — after the
    // picker applies something, it pokes the bar so the tooltip is right
    // immediately instead of at the next tick.
    "custom/display": {
      "exec": "~/.dotfiles/linux/bin/display probe",
      "return-type": "json",
      "interval": 5,
      "signal": 8,
      "on-click": "~/.dotfiles/linux/bin/display menu",
      "on-click-right": "~/.dotfiles/linux/bin/display reset"
    },

    // --- Right: the power profile -------------------------------------------
    // Sits immediately before the battery because it is the knob for the gauge
    // beside it: the one control on this bar that changes how fast the number
    // to its right goes down.
    //
    // Distinct from custom/power at the far end, which is the SESSION menu —
    // lock, log out, power off. Those are the same word answering different
    // questions, and conflating them would mean a single popup where "Power
    // saver" and "Power off" are two rows apart.
    //
    // linux/bin/power is the whole of it: it talks D-Bus to
    // net.hadess.PowerProfiles, which on Fedora 41+ is served by tuned-ppd and
    // elsewhere by power-profiles-daemon — the same interface GNOME's own
    // switcher uses, so this survives the daemon underneath being swapped.
    //
    // Polled at 30s rather than the display item's 5s, and deliberately: this
    // is a setting that changes when someone changes it, and the click that
    // changes it pokes SIGRTMIN+9 so the item is right immediately. The
    // interval is only there to notice a profile set from somewhere else —
    // GNOME's panel, `tuned-adm`, a low-battery auto-switch — and being 30
    // seconds late to that costs nothing. A bar that wakes to spawn a probe
    // every five seconds is the thing this item exists to help with.
    "custom/power-profile": {
      "exec": "~/.dotfiles/linux/bin/power probe",
      "return-type": "json",
      "interval": 30,
      "signal": 9,
      "on-click": "~/.dotfiles/linux/bin/power menu",
      "on-click-right": "~/.dotfiles/linux/bin/power reset"
    },

    "battery": {
      // Framework 13 reports as BAT1, not BAT0.
      "bat": "BAT1",
      "interval": 30,
      "states": { "critical": 15, "warning": 35, "good": 85 },
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-plugged": "󰚥 {capacity}%",
      "format-icons": ["󰁺", "󰁽", "󰂀", "󰂂", "󰁹"],
      "tooltip-format": "{timeTo} · {power:0.1f}W"
    },

    "clock": {
      "interval": 10,
      "format": "󰥔 {:%H:%M}",
      "format-alt": "󰃭 {:%a %d %b}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    // --- Right: the session menu ---------------------------------------------
    // A GTK menu rather than a script driving fuzzel or a wlogout overlay:
    // waybar builds the popup from power.xml itself and styles it with THIS
    // bar's stylesheet, so the menu takes the palette without a seventeenth
    // themed surface and without a package that is not already installed.
    //
    // The ids here are power.xml's ids. Log out goes through niri rather than
    // loginctl so it uses the compositor's own confirmation dialog — the same
    // one Mod+Shift+E raises — instead of ending the session on one click.
    "custom/power": {
      "format": "󰐥",
      "tooltip": true,
      "tooltip-format": "Session",
      "menu": "on-click",
      "menu-file": "$HOME/.config/waybar/power.xml",
      "menu-actions": {
        "lock": "swaylock -f",
        "logout": "niri msg action quit",
        "suspend": "systemctl suspend",
        "reboot": "systemctl reboot",
        "poweroff": "systemctl poweroff"
      }
    }
  },

  // =========================================================================
  // The dock — the bottom bar
  //
  // fuzzel is for when you can name the thing, the drawer for when you cannot,
  // and this is for the handful you open every day, where a fixed target beats
  // both. linux/bin/dock holds the list; each item here is one slot of it.
  //
  // These are `image` modules rather than `custom` ones, and that is the whole
  // of the real-icon change: a custom module can only return text, which is
  // what made this dock a row of Nerd Font glyphs. An image module takes a
  // path, so each slot now draws the application's own icon, resolved through
  // its .desktop file and the GTK icon theme — the same icon every other
  // launcher on this machine shows for it.
  //
  // Every module is the same four lines because the only difference between
  // them is the slot name. `dock icon` runs ONCE at startup and prints a path,
  // or prints nothing when nothing in that slot is installed — waybar gives an
  // image with no path the `empty` class, which the stylesheet collapses to
  // zero width, so the dock stays exactly as wide as this machine's
  // software. Install something and reload the bar rather than having it poll
  // twelve commands forever — `pkill -USR2 waybar`, or just run install.sh,
  // which sends that itself. SIGRTMIN+7 re-runs `dock icon` more cheaply, but
  // it only swaps the image: a slot that resolved nothing at startup is a
  // widget the drawer is already hiding, and a reload is what brings it back.
  //
  // NOT exclusive, unlike the top bar, and that is a change of mind. The old
  // note here said a dock windows can slide under is a dock you have to move
  // windows out of — true of a dock that is always drawn, and this one is not
  // drawn at all until you go looking for it. Reserving 68px along the bottom
  // of every output to display nothing is the worse trade: it is a strip of
  // screen you paid for and never see.
  //
  // The cost is real and worth stating. A layer-shell surface takes pointer
  // input across its whole area whether or not it painted anything there, and
  // waybar has no way to shape that region — so while the dock is invisible it
  // still swallows clicks in the band it occupies. That is why `height` came
  // down from 60 to 46: the band is the surface, so the surface is now only as
  // tall as the icons need. `Mod+D` takes it away entirely when even that is
  // in the way.
  // =========================================================================
  {
    "name": "dock",
    "on-sigusr1": "toggle",
    "layer": "top",
    "position": "bottom",
    "height": 52,
    // No bottom margin, and this is the fix for "it disappears when I hit the
    // bottom". A margin shortens the SURFACE, so the last 6px of the screen
    // were not the dock — running the pointer to the physical edge took it off
    // the dock and shut it again, which is exactly the movement anyone makes
    // reaching for a dock. The 6px gap is still there, but it is padding
    // inside the surface now (see #dockrow in the stylesheet) rather than a
    // strip of nothing outside it.
    "margin-bottom": 0,
    "spacing": 0,
    "exclusive": false,

    // Centred, and the window itself is transparent and full-width: the pill
    // you can see is drawn on .modules-center, so it is as wide as its
    // contents, while the window it sits in spans the output.
    //
    // Two nested groups, and the split is the whole trick: dockzone is what
    // the pointer has to reach, dockrow is what you can see.
    //
    // Which node can be hovered at all is the constraint. CSS :hover is GTK's
    // PRELIGHT flag, set from pointer crossing events, which need a
    // GdkWindow. Every waybar module — a group included — is wrapped in a
    // GtkEventBox and has one. The bar's layer-shell window and the plain
    // GtkBoxes it packs (.modules-left, .modules-center, .modules-right) do
    // not, so `window#waybar.dock:hover` and `.modules-center:hover` match
    // nothing; both were tried and the dock never appeared. Expanding pads
    // either side failed differently: waybar packs .modules-center at its
    // natural size, so `expand` has no leftover space to take.
    //
    // So dockzone is a module, and the stylesheet gives it 500px of padding
    // on each side. Padding is inside the widget, so its event box covers all
    // of it: a 1000px-plus strip of bottom edge that reveals the dock, with
    // the icons still centred in the middle of it.
    //
    // There is no drawer any more, and that is also a fix rather than a
    // simplification. The drawer's first child is its trigger, so making the
    // trigger wide and then collapsing it on hover was the only way to keep
    // the icons centred — and collapsing the thing the pointer is standing on
    // is unstable. Hover near its edge and it shrinks out from under you, the
    // pointer is no longer over it, it reopens, and the dock flickers. Nothing
    // changes size here now; only opacity does.
    "modules-left":   [],
    "modules-center": ["group/dockzone"],
    "modules-right":  [],

    "group/dockzone": {
      "orientation": "horizontal",
      "modules": ["group/dockrow"]
    },

    "group/dockrow": {
      "orientation": "horizontal",
      "modules": [
        "image#dock-term", "image#dock-editor", "image#dock-browser",
        "image#dock-claude", "image#dock-notes", "image#dock-chat",
        "image#dock-files",
        "custom/dock-sep",
        "image#dock-hud", "image#dock-git", "image#dock-containers",
        "image#dock-k8s", "image#dock-net"
      ]
    },

    // There is no group drawer here any more, and no chevron. A waybar drawer
    // reveals on ITS OWN hover, so the target was however wide its first child
    // was — one glyph in the middle of the output. Every slot is laid out all
    // the time now and the stylesheet fades the row in, which moves the target
    // from that glyph to the whole bottom edge.
    //
    // Mod+D still takes the surface away entirely: it sends SIGUSR1, and
    // on-sigusr1 above routes it to this bar and not the status bar.

    "image#dock-term": {
      "exec": "~/.dotfiles/linux/bin/dock icon term",
      "on-click": "~/.dotfiles/linux/bin/dock open term",
      "size": 34, "signal": 7
    },

    "image#dock-editor": {
      "exec": "~/.dotfiles/linux/bin/dock icon editor",
      "on-click": "~/.dotfiles/linux/bin/dock open editor",
      "size": 34, "signal": 7
    },

    "image#dock-browser": {
      "exec": "~/.dotfiles/linux/bin/dock icon browser",
      "on-click": "~/.dotfiles/linux/bin/dock open browser",
      "size": 34, "signal": 7
    },

    "image#dock-claude": {
      "exec": "~/.dotfiles/linux/bin/dock icon claude",
      "on-click": "~/.dotfiles/linux/bin/dock open claude",
      "size": 34, "signal": 7
    },

    "image#dock-notes": {
      "exec": "~/.dotfiles/linux/bin/dock icon notes",
      "on-click": "~/.dotfiles/linux/bin/dock open notes",
      "size": 34, "signal": 7
    },

    "image#dock-chat": {
      "exec": "~/.dotfiles/linux/bin/dock icon chat",
      "on-click": "~/.dotfiles/linux/bin/dock open chat",
      "size": 34, "signal": 7
    },

    "image#dock-files": {
      "exec": "~/.dotfiles/linux/bin/dock icon files",
      "on-click": "~/.dotfiles/linux/bin/dock open files",
      "size": 34, "signal": 7
    },

    // Applications to the left of this, the terminal toolbelt to the right.
    "custom/dock-sep": {
      "format": "│",
      "tooltip": false
    },

    "image#dock-hud": {
      "exec": "~/.dotfiles/linux/bin/dock icon hud",
      "on-click": "~/.dotfiles/linux/bin/dock open hud",
      "size": 34, "signal": 7
    },

    "image#dock-git": {
      "exec": "~/.dotfiles/linux/bin/dock icon git",
      "on-click": "~/.dotfiles/linux/bin/dock open git",
      "size": 34, "signal": 7
    },

    "image#dock-containers": {
      "exec": "~/.dotfiles/linux/bin/dock icon containers",
      "on-click": "~/.dotfiles/linux/bin/dock open containers",
      "size": 34, "signal": 7
    },

    // Nothing on this machine answers to k9s yet. That is the point of the
    // hide-when-absent rule: the slot is written down now, and the dock grows
    // an item the day the ops layer lands rather than needing a config edit.
    "image#dock-k8s": {
      "exec": "~/.dotfiles/linux/bin/dock icon k8s",
      "on-click": "~/.dotfiles/linux/bin/dock open k8s",
      "size": 34, "signal": 7
    },

    "image#dock-net": {
      "exec": "~/.dotfiles/linux/bin/dock icon net",
      "on-click": "~/.dotfiles/linux/bin/dock open net",
      "size": 34, "signal": 7
    }
  }
]
