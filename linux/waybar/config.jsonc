// ---------------------------------------------------------------------------
// Cyberpunk rice — Waybar
// ~/.dotfiles/linux/waybar/config.jsonc  ->  ~/.config/waybar/config.jsonc
//
// Two bars out of one process: the status bar along the top, and the
// application dock along the bottom. Waybar takes an ARRAY here and gives each
// object its own surface, which is why this is not two configs and two
// daemons — one reload (SIGUSR2) moves both, and one stylesheet paints both,
// with "name" as the class that tells them apart.
//
// The Linux stand-in for sketchybar/sketchybarrc. Read the right side
// right-to-left: clock, battery, disk, mem, cpu, net, link — the same order
// as the macOS bar.
//
// One structural difference worth knowing: on macOS, cpu/mem/disk/battery each
// needed a shell plugin, because `top`, `memory_pressure` and `pmset` have to
// be parsed. Waybar reads all four from /proc and /sys itself, so those four
// plugins simply don't exist here. The two that DO still need scripts are the
// netwatch-fed ones — link and net — because that data comes from netwatch's
// Prometheus endpoint, not from the kernel. That was always the point.
// ---------------------------------------------------------------------------
[
  {
    "name": "top",
    // SIGUSR1 is the dock's, not this bar's. Both bars come out of one waybar,
    // so the signal reaches both — and on-sigusr1 is a PER-BAR parameter,
    // which is what lets `pkill -USR1 waybar` mean "hide the dock" and leave
    // the status bar alone. That is the whole reason the dock did not need to
    // become a second process.
    "on-sigusr1": "noop",
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 2,

    "modules-left":   ["custom/launcher", "custom/run", "niri/workspaces", "custom/sep", "niri/window"],
    "modules-center": [],
    "modules-right":  ["custom/link", "custom/net", "cpu", "memory", "disk", "pulseaudio/slider", "wireplumber", "custom/display", "battery", "clock", "custom/power"],

    // --- Left: the launcher button ------------------------------------------
    // Opens nwg-drawer, not fuzzel: a button is for the times you are looking
    // rather than typing, and the drawer is the one that answers that. It drops
    // down from here as a panel, so the button and its menu read as one thing.
    // linux/bin/drawer is what sizes that panel to the current output and
    // toggles the resident copy. Typing has its own button beside this one —
    // it used to be this button's right-click, which is no more findable than
    // the keybind it was standing in for.
    "custom/launcher": {
      "format": "󰀻",
      "tooltip": true,
      "tooltip-format": "Browse applications  (Mod+A)",
      "on-click": "~/.dotfiles/linux/bin/drawer"
    },

    // --- Left: the run button ------------------------------------------------
    // The other half of the pair: fuzzel, for when you can name the thing.
    // Toggles, so a second click dismisses a prompt that is already up rather
    // than failing silently — fuzzel refuses to run twice.
    "custom/run": {
      "format": "󰍉",
      "tooltip": true,
      "tooltip-format": "Run a program  (Mod+Space)",
      "on-click": "pkill fuzzel || fuzzel"
    },

    // --- Left: niri workspaces, named exactly as the compositor names them ---
    "niri/workspaces": {
      "format": "{icon}",
      // Material Design glyphs, the same set the right-hand items use. The
      // labels were "1".."6", which the six pinned workspaces would have got
      // from {index} anyway — the map only earns its place saying something
      // the index cannot.
      "format-icons": {
        "term":  "󰆍",
        "code":  "󰅩",
        "web":   "󰖟",
        "chat":  "󰭹",
        "notes": "󰎚",
        "infra": "󰒋"
      },
      "on-click": "activate"
    },

    "custom/sep": {
      "format": "│",
      "tooltip": false
    },

    "niri/window": {
      "format": "  {}",
      "max-length": 48,
      "separate-outputs": true
    },

    // --- The two netwatch-fed items -----------------------------------------
    // --font-size, for the same reason the HUD carries one. netwatch's dense
    // view wants 130x44 and does not say so when it cannot have it — below 44
    // rows it quietly draws two of its four boxes, which reads as a broken
    // render rather than a refusal. A maximised ghostty on this display at the
    // configured 14 is 168x38: wide enough and six rows short, so `V` could
    // never reach dense however far you zoomed. At 11 it is 211x48.
    "custom/link": {
      "exec": "~/.config/waybar/scripts/link.sh",
      "return-type": "json",
      "interval": 5,
      "on-click": "ghostty --font-size=11 -e netwatch"
    },

    "custom/net": {
      "exec": "~/.config/waybar/scripts/net.sh",
      "return-type": "json",
      "interval": 2,
      "on-click": "ghostty --font-size=11 -e netwatch"
    },

    // --- Kernel-fed items ----------------------------------------------------
    "cpu": {
      "format": "󰻠 {usage}%",
      "interval": 3,
      "states": { "warning": 70, "critical": 90 },
      "on-click": "ghostty -e btop"
    },

    "memory": {
      "format": "󰍛 {percentage}%",
      "interval": 5,
      "states": { "warning": 80, "critical": 92 },
      "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
      "on-click": "ghostty -e btop"
    },

    "disk": {
      // On Linux `/` is the real root — no sealed-snapshot workaround needed.
      "path": "/",
      "format": "󰋊 {percentage_used}% · {free} free",
      "interval": 300,
      "states": { "warning": 85, "critical": 93 }
    },

    // --- Right: volume, as a thing you can actually drag ---------------------
    // Scrolling a bar item is a mouse-wheel gesture. This is a laptop, and on
    // this machine the module never received a scroll event at all — so the
    // volume was readable and mutable from the bar, and not settable, which is
    // the one thing a volume control is for.
    //
    // So the control is a slider: click anywhere on it to jump there, or drag
    // it. Both are gestures a trackpad is good at. The readout beside it keeps
    // the number and the mute state, and the scroll handlers stay configured
    // because they cost nothing and a mouse may yet get plugged in.
    "pulseaudio/slider": {
      "min": 0,
      "max": 100,
      "orientation": "horizontal"
    },

    // --- Right: volume ------------------------------------------------------
    // The wireplumber module, not pulseaudio: waybar links both, and this rice
    // runs PipeWire with wireplumber as its session manager — the same daemon
    // the Framework's hardware keys already drive through wpctl.
    //
    // Scroll sets it, click mutes, right-click opens soundwatch — the same
    // idiom as cpu and memory opening btop, and the two netwatch items opening
    // netwatch. Muting is what a volume item is mostly for, so it keeps the
    // left button and the tool gets the right.
    //
    // The scroll handlers are spelled out rather than left to the module's
    // built-in one, and the reason is the ceiling. waybar's own handler steps
    // by `scroll-step` up to `max-volume`; config.kdl's XF86Audio binds step by
    // 5% up to `--limit 1.0`. Two implementations of the same rule is one more
    // than is needed, and they drift the first time either number is edited.
    // The man page is explicit that on-scroll-up/down REPLACE the default, so
    // this is one rule: the bar runs the identical wpctl the keyboard runs.
    "wireplumber": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟 muted",
      "format-icons": ["󰕿", "󰖀", "󰕾"],
      "tooltip-format": "{node_name}  ·  {volume}%\ndrag the slider to set · click to mute · right-click for soundwatch",
      // Kept for a mouse, and a threshold so that if one ever is plugged in it
      // steps once per notch. Not the control this item relies on: see the
      // slider above for why.
      "smooth-scrolling-threshold": 1,
      "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.0",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "on-click-right": "ghostty -e soundwatch"
    },

    // --- Right: the display --------------------------------------------------
    // Sits beside volume because it is the same kind of thing: a hardware knob
    // you reach for a few times a week and never want to go hunting for.
    //
    // Click opens the picker — scales first, then every mode the focused output
    // actually reports. Right-click puts back what config.kdl asks for, which
    // matters more here than elsewhere: `niri msg output` is explicitly
    // temporary, so the bar can only ever hand you a setting for the afternoon.
    // linux/bin/display is where the whole of that is written down.
    //
    // Polled rather than pushed, at an interval slow enough not to matter: the
    // thing it is watching is a monitor being plugged in, and niri's event
    // stream is a socket this item would have to hold open all session to learn
    // that five seconds sooner. The signal is for the other case — after the
    // picker applies something, it pokes the bar so the tooltip is right
    // immediately instead of at the next tick.
    "custom/display": {
      "exec": "~/.dotfiles/linux/bin/display probe",
      "return-type": "json",
      "interval": 5,
      "signal": 8,
      "on-click": "~/.dotfiles/linux/bin/display menu",
      "on-click-right": "~/.dotfiles/linux/bin/display reset"
    },

    "battery": {
      // Framework 13 reports as BAT1, not BAT0.
      "bat": "BAT1",
      "interval": 30,
      "states": { "critical": 15, "warning": 35, "good": 85 },
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-plugged": "󰚥 {capacity}%",
      "format-icons": ["󰁺", "󰁽", "󰂀", "󰂂", "󰁹"],
      "tooltip-format": "{timeTo} · {power:0.1f}W"
    },

    "clock": {
      "interval": 10,
      "format": "󰥔 {:%H:%M}",
      "format-alt": "󰃭 {:%a %d %b}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    // --- Right: the session menu ---------------------------------------------
    // A GTK menu rather than a script driving fuzzel or a wlogout overlay:
    // waybar builds the popup from power.xml itself and styles it with THIS
    // bar's stylesheet, so the menu takes the palette without a seventeenth
    // themed surface and without a package that is not already installed.
    //
    // The ids here are power.xml's ids. Log out goes through niri rather than
    // loginctl so it uses the compositor's own confirmation dialog — the same
    // one Mod+Shift+E raises — instead of ending the session on one click.
    "custom/power": {
      "format": "󰐥",
      "tooltip": true,
      "tooltip-format": "Session",
      "menu": "on-click",
      "menu-file": "$HOME/.config/waybar/power.xml",
      "menu-actions": {
        "lock": "swaylock -f",
        "logout": "niri msg action quit",
        "suspend": "systemctl suspend",
        "reboot": "systemctl reboot",
        "poweroff": "systemctl poweroff"
      }
    }
  },

  // =========================================================================
  // The dock — the bottom bar
  //
  // fuzzel is for when you can name the thing, the drawer for when you cannot,
  // and this is for the handful you open every day, where a fixed target beats
  // both. linux/bin/dock holds the list; each item here is one slot of it.
  //
  // Every module is the same five lines because the only difference between
  // them is the slot name. `probe` runs ONCE at startup and prints the glyph,
  // or prints nothing when nothing in that slot is installed — waybar hides an
  // item with no text, so the dock is exactly as wide as this machine's
  // software. Install something and reload the bar rather than having it poll
  // twelve commands forever — `pkill -USR2 waybar`, or just run install.sh,
  // which sends that itself. SIGRTMIN+7 re-runs a probe more cheaply, but it
  // only refreshes text: a slot that resolved nothing at startup is a widget
  // the drawer is already hiding, and a reload is what brings it back.
  //
  // Exclusive, like the top bar: a dock that windows can slide under is a dock
  // you have to move windows out of, which is the opposite of one click.
  // =========================================================================
  {
    "name": "dock",
    "on-sigusr1": "toggle",
    "layer": "top",
    "position": "bottom",
    "height": 60,
    "margin-bottom": 8,
    "spacing": 0,

    // Centred, and the window itself is transparent: the pill you can see is
    // drawn on .modules-center, so it is as wide as its contents instead of
    // stretching the full output the way the top bar does.
    "modules-left":   [],
    "modules-center": ["group/dock"],
    "modules-right":  [],

    // Auto-hide, waybar's own way: a group drawer shows its FIRST child and
    // keeps the rest behind a hover. So the dock at rest is one chevron, and
    // pointing at it slides the icons out.
    //
    // This is the version of auto-hide a Wayland bar can actually implement. A
    // client cannot ask where the pointer is, so "reveal when the cursor
    // reaches the bottom edge" would need something with a surface already
    // sitting at that edge to notice — which is what the chevron is. Hiding
    // the bar outright leaves nothing to hover, and `mode: hide` reveals on a
    // modifier that only Sway sends.
    //
    // Mod+D hides the chevron too, when even that is too much: it sends
    // SIGUSR1, and on-sigusr1 above routes it to this bar alone.
    "group/dock": {
      "orientation": "horizontal",
      "drawer": {
        "transition-duration": 250,
        "children-class": "dock-hidden",
        "transition-left-to-right": true
      },
      "modules": [
        "custom/dock-handle",
        "custom/dock-term", "custom/dock-editor", "custom/dock-browser",
        "custom/dock-claude", "custom/dock-notes", "custom/dock-chat",
        "custom/dock-files",
        "custom/dock-sep",
        "custom/dock-hud", "custom/dock-git", "custom/dock-containers",
        "custom/dock-k8s", "custom/dock-net"
      ]
    },

    // The handle: the one thing that stays. A chevron because it points at
    // where the dock comes from.
    "custom/dock-handle": {
      "format": "󰅃",
      "tooltip": true,
      "tooltip-format": "Applications — hover to open  (Mod+D hides the dock)"
    },

    "custom/dock-term": {
      "exec": "~/.dotfiles/linux/bin/dock probe term",
      "on-click": "~/.dotfiles/linux/bin/dock open term",
      "return-type": "json", "interval": "once", "signal": 7
    },

    "custom/dock-editor": {
      "exec": "~/.dotfiles/linux/bin/dock probe editor",
      "on-click": "~/.dotfiles/linux/bin/dock open editor",
      "return-type": "json", "interval": "once", "signal": 7
    },

    "custom/dock-browser": {
      "exec": "~/.dotfiles/linux/bin/dock probe browser",
      "on-click": "~/.dotfiles/linux/bin/dock open browser",
      "return-type": "json", "interval": "once", "signal": 7
    },

    "custom/dock-claude": {
      "exec": "~/.dotfiles/linux/bin/dock probe claude",
      "on-click": "~/.dotfiles/linux/bin/dock open claude",
      "return-type": "json", "interval": "once", "signal": 7
    },

    "custom/dock-notes": {
      "exec": "~/.dotfiles/linux/bin/dock probe notes",
      "on-click": "~/.dotfiles/linux/bin/dock open notes",
      "return-type": "json", "interval": "once", "signal": 7
    },

    "custom/dock-chat": {
      "exec": "~/.dotfiles/linux/bin/dock probe chat",
      "on-click": "~/.dotfiles/linux/bin/dock open chat",
      "return-type": "json", "interval": "once", "signal": 7
    },

    "custom/dock-files": {
      "exec": "~/.dotfiles/linux/bin/dock probe files",
      "on-click": "~/.dotfiles/linux/bin/dock open files",
      "return-type": "json", "interval": "once", "signal": 7
    },

    // Applications to the left of this, the terminal toolbelt to the right.
    "custom/dock-sep": {
      "format": "│",
      "tooltip": false
    },

    "custom/dock-hud": {
      "exec": "~/.dotfiles/linux/bin/dock probe hud",
      "on-click": "~/.dotfiles/linux/bin/dock open hud",
      "return-type": "json", "interval": "once", "signal": 7
    },

    "custom/dock-git": {
      "exec": "~/.dotfiles/linux/bin/dock probe git",
      "on-click": "~/.dotfiles/linux/bin/dock open git",
      "return-type": "json", "interval": "once", "signal": 7
    },

    "custom/dock-containers": {
      "exec": "~/.dotfiles/linux/bin/dock probe containers",
      "on-click": "~/.dotfiles/linux/bin/dock open containers",
      "return-type": "json", "interval": "once", "signal": 7
    },

    // Nothing on this machine answers to k9s yet. That is the point of the
    // hide-when-absent rule: the slot is written down now, and the dock grows
    // an item the day the ops layer lands rather than needing a config edit.
    "custom/dock-k8s": {
      "exec": "~/.dotfiles/linux/bin/dock probe k8s",
      "on-click": "~/.dotfiles/linux/bin/dock open k8s",
      "return-type": "json", "interval": "once", "signal": 7
    },

    "custom/dock-net": {
      "exec": "~/.dotfiles/linux/bin/dock probe net",
      "on-click": "~/.dotfiles/linux/bin/dock open net",
      "return-type": "json", "interval": "once", "signal": 7
    }
  }
]
