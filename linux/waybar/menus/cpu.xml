<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cyberpunk rice — the CPU menu, on cpu
  ~/.dotfiles/linux/waybar/menus/cpu.xml  ->  ~/.config/waybar/menus/cpu.xml

  btop keeps the left button — it is the answer nine times out of ten. The row
  that earns this menu is the tenth: the process list, which answers "what is
  it" without making you find it in btop yourself, and hands the PID to the
  clipboard so the next command can have it.
-->
<interface>
  <object class="GtkMenu" id="menu">

    <child>
      <object class="GtkMenuItem" id="btop">
        <property name="visible">True</property>
        <property name="name">btop</property>
        <property name="label">󰍛   Open btop</property>
      </object>
    </child>

    <child>
      <object class="GtkMenuItem" id="hud">
        <property name="visible">True</property>
        <property name="name">hud</property>
        <property name="label">󰕰   Open the HUD</property>
      </object>
    </child>

    <child>
      <object class="GtkSeparatorMenuItem" id="sep1">
        <property name="visible">True</property>
      </object>
    </child>

    <child>
      <object class="GtkMenuItem" id="top">
        <property name="visible">True</property>
        <property name="name">top</property>
        <property name="label">󰈸   Busiest processes…</property>
      </object>
    </child>

    <child>
      <object class="GtkSeparatorMenuItem" id="sep2">
        <property name="visible">True</property>
      </object>
    </child>

    <child>
      <object class="GtkMenuItem" id="load">
        <property name="visible">True</property>
        <property name="name">load</property>
        <property name="label">󰅇   Copy the load average</property>
      </object>
    </child>

  </object>
</interface>
