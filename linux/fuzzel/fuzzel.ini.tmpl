# ---------------------------------------------------------------------------
# Cyberpunk rice — fuzzel
# ~/.dotfiles/linux/fuzzel/fuzzel.ini  ->  ~/.config/fuzzel/fuzzel.ini
#
# Rendered from themes/__CP_THEME_SLUG__.sh by `theme` — edit the .tmpl.
#
# fuzzel had no config at all until now, which meant the one surface this rice
# leans on hardest was the only one not wearing the palette: a cream popup with
# dark text, in the middle of a dark desktop. It was easy to miss because the
# things that opened it were rare — the network picker, the mode picker — and
# it stopped being rare the moment the right-click menus landed.
#
# What comes through here: Mod+Space, the run button, the network picker, the
# display and power pickers, the wallpaper picker, all twelve dock menus, the
# workspace strip, the desktop, the process lists, the timezone list, and every
# confirmation and copy note in linux/bin/ctx. It is the rice's second most
# looked-at surface after the bar.
#
# So it is styled to match the bar's menus rather than to be its own thing:
# same @bg_alt ground, same purple hairline, same magenta selection with the
# background colour as its text. A GtkMenu on the bar and a fuzzel list under
# the pointer should read as two shapes of one system.
# ---------------------------------------------------------------------------

# The rice's font, at the bar's size rather than the terminal's — these lists
# are chrome, not content, and 14 makes a seven-row menu taller than it needs
# to be. Nerd Font because every row this rice puts through fuzzel now leads
# with a Material Design glyph, exactly like the menu-file rows do.
font=JetBrainsMono Nerd Font:size=11
dpi-aware=no

# Layout. Callers pass --lines and --width for their own list, so these are
# only the fallback for anything that does not.
lines=8
width=32
tabs=4
horizontal-pad=18
vertical-pad=14
inner-pad=10
line-height=22

# Off, and deliberately. fuzzel's icon lookup is for the application launcher;
# in a menu every row would get a generic stand-in that says nothing, and the
# glyph the row already carries says it better in a tenth of the space.
icons-enabled=no

# The prompt is where the caller says what the list IS ("wifi", "desktop",
# "workspace term"), so it gets the accent and a space to sit in.
prompt="❯ "

[colors]
background=__CP_BG_ALT_RAW__f2
text=__CP_FG_RAW__ff
prompt=__CP_MAGENTA_RAW__ff
placeholder=__CP_FG_DIM_RAW__ff
input=__CP_FG_STRONG_RAW__ff
match=__CP_MAGENTA_RAW__ff
selection=__CP_MAGENTA_RAW__ff
selection-text=__CP_BG_RAW__ff
selection-match=__CP_BG_RAW__ff
counter=__CP_FG_DIM_RAW__ff
border=__CP_PURPLE_RAW__ff

[border]
width=1
radius=8

[dmenu]
# Every menu in this rice is a fixed list of rows, not a search over a corpus,
# so exit-immediately-if-empty would close the menu the instant the list was
# filtered to nothing by a typo.
exit-immediately-if-empty=no

[key-bindings]
# Escape and Ctrl-C both cancel; a menu you opened by accident should close
# with whichever one your hand reaches for.
cancel=Escape Control+c Control+g
