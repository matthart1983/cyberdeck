#!/usr/bin/env bash
# JankyBorders — the accent colour on the focused window, the inactive-border
# colour on the rest.
# Rendered from themes/__CP_THEME_SLUG__.sh by `theme` — edit the .tmpl, not this.
# Launched by AeroSpace's after-startup-command.
exec /opt/homebrew/bin/borders \
  active_color=0xff__CP_MAGENTA_RAW__ \
  inactive_color=0x80__CP_PURPLE_RAW__ \
  width=5.0 \
  style=round \
  hidpi=on \
  ax_focus=on
